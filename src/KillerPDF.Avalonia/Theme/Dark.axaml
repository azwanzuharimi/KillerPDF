<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="BackgroundBrush" Color="#1c1c1c"/>
  <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#1e1e1e"/>
  <SolidColorBrush x:Key="CardBorderBrush" Color="#2e2e2e"/>
  <SolidColorBrush x:Key="SelectionAccent" Color="#1ea54c"/>
  <SolidColorBrush x:Key="PaneBorderBrush" Color="#3f3f3f"/>
  <SolidColorBrush x:Key="InputBorderBrush" Color="#2e2e2e"/>
</ResourceDictionary>
